# ── Client Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.

# Backend API URL
# In development: leave empty (Vite proxy handles /api forwarding)
# In production:  set to your Render backend URL
# Example: VITE_API_URL=https://agrishield-api.onrender.com
VITE_API_URL=
